# Copy to the repository root as `.env` (gitignored). Never commit real values.
# Base URL of the Strapi admin API, without a trailing slash, e.g. https://<host>/strapi
STRAPI_ADMIN_URL=
# Option A: pre-issued admin JWT or API token
STRAPI_ADMIN_TOKEN=
# Option B: admin login (used only when STRAPI_ADMIN_TOKEN is empty)
STRAPI_ADMIN_EMAIL=
STRAPI_ADMIN_PASSWORD=
