{
  "$id": "product-page-layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "page", "contentHash", "skill", "surfacePack", "shellZones", "hero", "sections", "tokensUsed", "warnings", "decisionBasis"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "page": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "version"],
      "properties": {
        "id": { "const": "page-layout" },
        "owner": { "const": "designer" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "surfacePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "shellZones": { "type": "array", "items": { "type": "string" } },
    "hero": { "$ref": "#/$defs/entry" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/entry" },
          { "required": ["contentId"], "properties": { "contentId": { "type": "string", "minLength": 1 } } }
        ]
      }
    },
    "tokensUsed": { "type": "array", "items": { "type": "string", "pattern": "^--" }, "uniqueItems": true },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "decisionBasis": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "options"],
      "properties": {
        "contentId": { "type": "string" },
        "pattern": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "options": { "type": "object" }
      }
    }
  }
}
