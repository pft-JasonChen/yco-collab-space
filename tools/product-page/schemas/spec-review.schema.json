{
  "$id": "product-page-spec-review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "page", "contentHash", "reviewedAt", "reviewer", "builder", "verdict", "findings", "coverage", "decisionBasis"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "page": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewedAt": { "type": "string", "minLength": 1 },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "adapter", "independentOfBuilder"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "independentOfBuilder": { "const": true },
        "rubricSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string" }
      }
    },
    "verdict": { "enum": ["pass", "pass-with-notes", "fail"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "type", "path", "evidence"],
        "properties": {
          "severity": { "enum": ["blocker", "major", "minor"] },
          "type": { "enum": ["exceeds-spec", "contradicts-spec", "unsupported-number", "missing-required", "weak-source", "competitor-as-capability-source", "voice", "length"] },
          "path": { "type": "string", "pattern": "^/" },
          "evidence": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string" }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionsReviewed", "claimsChecked"],
      "properties": {
        "sectionsReviewed": { "type": "integer", "minimum": 0 },
        "claimsChecked": { "type": "integer", "minimum": 0 }
      }
    },
    "decisionBasis": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
