{
  "$id": "integration",
  "title": "RD integration surface",
  "description": "Files outside the feature folder that RD must change to register this module. Derived by the agent from the RD snapshot, so it tracks the snapshot rather than a hand-maintained list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "feature", "derivedFrom", "registrationSurface", "portedLayers", "decisionBasis"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "feature": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "derivedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "sourceVersion", "referenceModule"],
      "properties": {
        "snapshot": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "referenceModule": {
          "description": "The existing RD module whose registration surface was traced.",
          "type": "string", "minLength": 1
        }
      }
    },
    "registrationSurface": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "need"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "need": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "portedLayers": {
      "description": "What RD can take from generated/, and how.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "path", "handling"],
        "properties": {
          "layer": { "enum": ["L1-composition", "L2-data", "L3-orchestration", "L4-contract", "assets"] },
          "path": { "type": "string", "minLength": 1 },
          "handling": { "enum": ["copy-with-alias-swap", "copy-as-is", "rewrite-against-rd-hooks", "reference-only"] },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "i18nKeySource": { "type": "string", "minLength": 1 },
    "decisionBasis": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
