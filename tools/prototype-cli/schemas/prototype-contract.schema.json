{
  "$id": "prototype-contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "feature",
    "design",
    "states",
    "actions",
    "mocks",
    "acceptance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "stage", "entryRoute", "intakeStatus"],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": ["pm-draft", "pm-approved", "design-working", "design-review", "design-final"]
        },
        "entryRoute": {
          "type": "string",
          "pattern": "^/features/[a-z0-9-]+/$"
        },
        "intakeStatus": {
          "enum": ["draft", "confirmed"]
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference"],
      "properties": {
        "status": {
          "enum": ["temporary", "final"]
        },
        "reference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "event", "to"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^mocks/.+\\.json$"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
