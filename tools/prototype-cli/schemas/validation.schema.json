{
  "$id": "feature-validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "feature", "route", "checks"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "route": {
      "type": "string",
      "pattern": "^/features/[a-z0-9-]+/$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "assertions"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "selector"],
              "properties": {
                "action": {
                  "enum": [
                    "click",
                    "fill",
                    "select",
                    "check",
                    "uncheck",
                    "press",
                    "hover"
                  ]
                },
                "selector": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "action": {
                        "enum": ["fill", "select", "press"]
                      }
                    }
                  },
                  "then": {
                    "required": ["value"]
                  }
                }
              ]
            }
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "selector"],
              "properties": {
                "type": {
                  "enum": [
                    "visible",
                    "hidden",
                    "text",
                    "count",
                    "attribute",
                    "value",
                    "checked"
                  ]
                },
                "selector": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "enum": ["text", "count", "value", "checked"]
                      }
                    }
                  },
                  "then": {
                    "required": ["value"]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "attribute"
                      }
                    }
                  },
                  "then": {
                    "required": ["name", "value"]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
