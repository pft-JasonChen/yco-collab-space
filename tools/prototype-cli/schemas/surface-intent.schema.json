{
  "$id": "surface-intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "feature",
    "strategy",
    "temporary",
    "primaryPack",
    "borrowedPacks",
    "layoutIntent",
    "deviations",
    "decisionBasis",
    "componentReuse"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "strategy": {
      "enum": [
        "reuse",
        "hybrid",
        "novel"
      ]
    },
    "temporary": {
      "type": "boolean"
    },
    "primaryPack": {
      "anyOf": [
        {
          "$ref": "#/$defs/packReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "borrowedPacks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/borrowedPackReference"
      }
    },
    "layoutIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zones",
        "componentRoles",
        "responsivePriority"
      ],
      "properties": {
        "zones": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "componentRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "responsivePriority": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "presence": {
          "description": "How a zone or component role is reached. at-rest (default): visible on the entry route before any interaction, so the rendered check asserts it at every viewport. on-interaction: reached through a user action such as a dialog, menu or toolbar. conditional: present only in some data or viewport state, such as a breadcrumb inside a folder or an empty state. deferred: declared in the composition but not rendered in this revision; a reason is required. Only at-rest entries are asserted visible by test:rendered. Ids may name zones or roles the feature declares or ones a pinned pack contributes.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zones": {
              "$ref": "#/$defs/presenceMap"
            },
            "componentRoles": {
              "$ref": "#/$defs/presenceMap"
            }
          }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisionBasis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "componentReuse": {
      "description": "Reuse evidence for every declared component role. Intake must resolve each role against `npm run library:components` before any feature UI is generated, so an existing shared component is never rebuilt by accident.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/componentReuseEntry"
      }
    }
  },
  "$defs": {
    "presenceKind": {
      "enum": [
        "at-rest",
        "on-interaction",
        "conditional",
        "deferred"
      ]
    },
    "presenceMap": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "anyOf": [
            {
              "$ref": "#/$defs/presenceKind"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "presence"
              ],
              "properties": {
                "presence": {
                  "$ref": "#/$defs/presenceKind"
                },
                "via": {
                  "description": "Acceptance criterion id whose validation check reaches this zone or role.",
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "description": "Required for deferred entries: why the composition declares it but this revision does not render it.",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "packReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}(?:-[a-z0-9-]+)?$"
        }
      }
    },
    "borrowedPackReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "roles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(?:/[a-z0-9-]+)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}(?:-[a-z0-9-]+)?$"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "componentReuseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "resolution",
        "evidence"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "resolution": {
          "description": "existing-component: a catalogued shared component covers this role. new-shared: nothing covers it and it belongs in platform/ui. feature-only: it is specific to this feature and stays in generated/.",
          "enum": [
            "existing-component",
            "new-shared",
            "feature-only"
          ]
        },
        "component": {
          "description": "Catalogued component id. Required when resolution is existing-component or new-shared.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "strategy": {
            "const": "reuse"
          }
        }
      },
      "then": {
        "properties": {
          "primaryPack": {
            "$ref": "#/$defs/packReference"
          },
          "borrowedPacks": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "strategy": {
            "const": "hybrid"
          }
        }
      },
      "then": {
        "properties": {
          "primaryPack": {
            "$ref": "#/$defs/packReference"
          },
          "borrowedPacks": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "strategy": {
            "const": "novel"
          }
        }
      },
      "then": {
        "properties": {
          "primaryPack": {
            "type": "null"
          },
          "borrowedPacks": {
            "maxItems": 0
          },
          "layoutIntent": {
            "properties": {
              "zones": {
                "minItems": 1
              },
              "componentRoles": {
                "minItems": 1
              },
              "responsivePriority": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
