{
  "name": "yco-collab-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node tools/prototype-cli/run-vite.mjs dev",
    "preview": "node tools/prototype-cli/run-vite.mjs preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "node tools/design-library/run-storybook-checks.mjs",
    "validate:contract": "node tools/collab-space/validate-contract.mjs",
    "validate:stages": "node tools/collab-space/validate-stages.mjs",
    "stage:transition": "node tools/collab-space/transition-stage.mjs",
    "docs:generate": "node tools/collab-space/generate-reference.mjs",
    "docs:check": "node tools/collab-space/generate-reference.mjs --check",
    "library:index": "node tools/design-library/index-library.mjs",
    "library:query": "node tools/design-library/query-library.mjs",
    "library:components": "node tools/design-library/list-components.mjs",
    "library:browser": "node tools/design-library/browser-server.mjs",
    "validate:components": "node tools/design-library/validate-components.mjs",
    "validate:rd-parity": "node tools/design-library/validate-rd-parity.mjs",
    "validate:geometry": "node tools/design-library/validate-geometry.mjs",
    "validate:snapshot": "node tools/migration/validate-snapshot.mjs",
    "validate:modules": "node tools/migration/audit-modules.mjs",
    "snapshot:vendor": "node tools/migration/vendor-snapshot.mjs",
    "snapshot:site-map": "node tools/migration/generate-site-map.mjs",
    "snapshot:patterns": "node tools/migration/generate-surface-patterns.mjs",
    "validate:public-build": "node tools/design-library/validate-public-build.mjs",
    "validate:inputs": "node tools/prototype-cli/validate-inputs.mjs",
    "validate:intake": "node tools/prototype-cli/validate-inputs.mjs --intake-only",
    "validate:surfaces": "node tools/prototype-cli/validate-surfaces.mjs",
    "validate:tokens": "node tools/prototype-cli/validate-tokens.mjs",
    "validate:network": "node tools/prototype-cli/validate-network.mjs",
    "validate": "npm run validate:contract && npm run docs:check && npm run validate:stages && npm run validate:components && npm run validate:rd-parity && npm run validate:geometry && npm run validate:snapshot && npm run validate:modules && npm run validate:surfaces && npm run validate:inputs && npm run validate:tokens && npm run validate:network && npm test",
    "build:app": "vite build",
    "build": "npm run validate && npm run build:app && npm run validate:public-build",
    "test": "node --test",
    "test:rendered": "node tools/validation/run-rendered-checks.mjs",
    "prototype:record": "node tools/prototype-cli/record-generation.mjs",
    "prototype:create": "node tools/prototype-cli/create-feature.mjs",
    "prototype:update:begin": "node tools/prototype-cli/source-guard.mjs snapshot",
    "prototype:update:check": "node tools/prototype-cli/source-guard.mjs check",
    "prototype:check": "npm run build && npm run test:rendered",
    "eval:workflow": "node tools/evaluation/run-workflow-eval.mjs",
    "eval:mutations": "node tools/evaluation/run-mutation-suite.mjs",
    "eval:visual:packet": "node tools/evaluation/create-visual-review-packet.mjs"
  },
  "dependencies": {
    "mediabunny": "^1.50.8",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/react": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "axe-core": "^4.13.0",
    "playwright": "1.59.0",
    "sass": "1.103.1",
    "storybook": "^10.5.0",
    "vite": "8.2.2",
    "yaml": "2.9.0"
  }
}
